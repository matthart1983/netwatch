#!/bin/sh
# Stops and disables netwatch.service when the package is removed. An upgrade
# leaves it running; postinst restarts it onto the new binary.
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl stop netwatch.service || true
    systemctl disable netwatch.service >/dev/null 2>&1 || true
fi

exit 0
