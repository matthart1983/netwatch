<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  netwatch daemon (macOS LaunchDaemon), with the flow log on.

  The .dmg from scripts/build-dmg.sh installs this file and the binary. By hand:
    sudo install -m0755 target/release/netwatch /usr/local/bin/netwatch
    sudo mkdir -p /var/log/netwatch && sudo chmod 0700 /var/log/netwatch
    sudo cp packaging/launchd/com.netwatch.agent.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.netwatch.agent.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.netwatch.agent.plist

  The daemon flushes its log queue on SIGTERM; launchd sends SIGTERM on
  unload and waits ExitTimeOut seconds before SIGKILL.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.netwatch.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/netwatch</string>
        <string>daemon</string>
        <string>--flow-log</string>
        <string>file</string>
        <string>--flow-log-dir</string>
        <string>/var/log/netwatch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Graceful stop: SIGTERM, then allow the queue flush to complete. -->
    <key>ExitTimeOut</key>
    <integer>15</integer>

    <key>StandardErrorPath</key>
    <string>/var/log/netwatch-agent.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
